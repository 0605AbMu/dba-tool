<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DbaTool.Api</RootNamespace>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.8.2" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <!-- Bundle nfrastack dbb CLI binary into bin/dbb in build & publish output -->
  <ItemGroup>
    <Content Include="..\bin\dbb" Link="bin\dbb" Condition="Exists('..\bin\dbb')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy built frontend SPA assets into wwwroot during Build if dist exists -->
  <Target Name="SyncFrontendDistOnBuild" BeforeTargets="Build" Condition="Exists('..\frontend\dist\index.html')">
    <ItemGroup>
      <_FrontendBuildDist Include="..\frontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrontendBuildDist)" DestinationFiles="@(_FrontendBuildDist->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Build & bundle frontend SPA + dbb binary automatically on dotnet publish -->
  <Target Name="BundleFrontendSpaOnPublish" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm run build" WorkingDirectory="..\frontend" Condition="Exists('..\frontend\package.json')" />
    <ItemGroup Condition="Exists('..\frontend\dist\index.html')">
      <_FrontendDistFiles Include="..\frontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrontendDistFiles)" DestinationFiles="@(_FrontendDistFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('..\frontend\dist\index.html')" />
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\wwwroot')">
      <_WwwRootPublishFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
      <ResolvedFileToPublish Include="@(_WwwRootPublishFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
